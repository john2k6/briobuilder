{
  "name": "rail-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "catalog": "node scripts/generate-catalog.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "e2e": "playwright test",
    "format": "prettier --write src e2e"
  },
  "dependencies": {
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "react": "^19.2.9",
    "react-dom": "^19.2.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
